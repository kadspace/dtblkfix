# Builds the DtBlkFx engine and its VSTGUI editor as a static library against the plugin shim.
#
# dtblkfix_add_engine(<target> <source root>) takes the sources from <source root>, which is the
# repo itself, or a checkout of another revision (the tests build the original engine this way to
# compare renders). The shim always comes from this repo.

set(DTBLKFIX_SHIM_DIR ${CMAKE_CURRENT_LIST_DIR}/../shim)
get_filename_component(DTBLKFIX_SHIM_DIR ${DTBLKFIX_SHIM_DIR} ABSOLUTE)

# The engine includes the plugin base class through the SDK's paths. These forwarding headers
# point those paths at the shim, so the same sources build with the real SDK (projects/) or here.
set(DTBLKFIX_SHIM_FWD_DIR ${CMAKE_BINARY_DIR}/shim_include)
foreach(fwd
    "vstsdk/public.sdk/source/vst2.x/audioeffectx.h:audioeffectx.h"
    "vstsdk/public.sdk/source/vst2.x/audioeffect.h:audioeffect.h"
    "vstsdk/public.sdk/source/vst2.x/aeffeditor.h:aeffeditor.h"
    "public.sdk/source/vst2.x/aeffeditor.h:aeffeditor.h")
  string(REPLACE ":" ";" fwd "${fwd}")
  list(GET fwd 0 fwd_path)
  list(GET fwd 1 fwd_target)
  set(fwd_text "// generated by cmake/DtBlkFixEngine.cmake\n#include \"${DTBLKFIX_SHIM_DIR}/${fwd_target}\"\n")
  if(EXISTS ${DTBLKFIX_SHIM_FWD_DIR}/${fwd_path})
    file(READ ${DTBLKFIX_SHIM_FWD_DIR}/${fwd_path} fwd_old)
  else()
    set(fwd_old "")
  endif()
  if(NOT fwd_old STREQUAL fwd_text)
    file(WRITE ${DTBLKFIX_SHIM_FWD_DIR}/${fwd_path} "${fwd_text}")
  endif()
endforeach()

set(DTBLKFIX_ENGINE_DEFS WIN32 _WINDOWS WINDOWS=1 STEREO NOMINMAX _CRT_SECURE_NO_DEPRECATE
    _CRT_SECURE_NO_WARNINGS)

function(dtblkfix_engine_options target)
  target_compile_definitions(${target} PRIVATE ${DTBLKFIX_ENGINE_DEFS})
  if(MSVC)
    # as in projects/DTBlkFx.vcxproj (release|x64)
    target_compile_options(${target} PRIVATE /O2 /Ob2 /Oi /Ot /fp:fast /W1 /wd4996 /wd4244 /wd4267
                                             /permissive)
  else()
    target_compile_options(${target} PRIVATE -O2 -ffast-math -msse2 -fpermissive -w)
  endif()
endfunction()

# libpng and zlib, as vendored
function(dtblkfix_add_png target root)
  set(png png.c pngerror.c pngget.c pngmem.c pngpread.c pngread.c pngrio.c pngrtran.c
      pngrutil.c pngset.c pngtrans.c pngwio.c pngwrite.c pngwtran.c pngwutil.c)
  set(z adler32.c compress.c crc32.c deflate.c gzio.c infback.c inffast.c inflate.c inftrees.c
      trees.c uncompr.c zutil.c)
  list(TRANSFORM png PREPEND ${root}/libpng/)
  list(TRANSFORM z PREPEND ${root}/zlib/)
  add_library(${target} STATIC ${png} ${z})
  target_include_directories(${target} PUBLIC ${root}/zlib ${root}/libpng)
  target_compile_definitions(${target} PRIVATE WIN32 NDEBUG _CRT_SECURE_NO_WARNINGS
                                               PNG_NO_MMX_CODE)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W0)
  else()
    target_compile_options(${target} PRIVATE -w)
  endif()
endfunction()

function(dtblkfix_add_engine target root)
  set(engine DtBlkFx.cpp DtBlkFxMain.cpp FxCtrl.cpp FxRun1_0.cpp FxState1_0.cpp GlobalCtrl.cpp
      Gui.cpp PixelFreqBin.cpp rfftw_float.cpp Spectrogram.cpp sweep1_coeff.cpp sweep2_coeff.cpp
      sweep3_coeff.cpp sweep4_coeff.cpp sweep5_coeff.cpp fftw_support.cpp fft_frac_shift.cpp
      HtmlLog.cpp misc_stuff.cpp NoteFreq.cpp PngVstGui.cpp VstGuiSupport.cpp)
  set(gui aeffguieditor.cpp vstcontrols.cpp vstgui.cpp)
  list(TRANSFORM engine PREPEND ${root}/dtblkfx/)
  list(TRANSFORM gui PREPEND ${root}/vstgui/)
  foreach(extra ${ARGN})
    list(APPEND engine ${root}/${extra})
  endforeach()

  add_library(${target} STATIC ${engine} ${gui} ${DTBLKFIX_SHIM_DIR}/audioeffect.cpp)
  target_include_directories(${target}
    PUBLIC ${DTBLKFIX_SHIM_FWD_DIR} ${DTBLKFIX_SHIM_DIR} ${root}/projects ${root} ${root}/dtblkfx
           ${root}/zlib ${DTBLKFIX_EXTRA_INCLUDE})
  dtblkfix_engine_options(${target})
  target_compile_definitions(${target} PUBLIC STEREO)
  target_link_libraries(${target} PUBLIC dtblkfix_png user32 gdi32 msimg32 ole32 comdlg32 shell32
                                         advapi32 uuid)
endfunction()
